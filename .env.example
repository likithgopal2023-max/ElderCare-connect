# GEMINI_API_KEY: Required for Gemini AI API calls (CareAI, document summarization, routine insights).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API Key for clinic maps and routing.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# SMTP / Email Notification Service credentials (server-side only)
EMAIL_SERVICE_API_KEY="MY_EMAIL_SERVICE_API_KEY"
EMAIL_FROM_ADDRESS="alerts@eldercareconnect.org"
